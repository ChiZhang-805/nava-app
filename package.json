{
  "name": "nava-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite-with-project-env.mjs --host 0.0.0.0",
    "build": "tsc -b && node scripts/run-vite-with-project-env.mjs build && node scripts/prepare-sites-build.mjs",
    "build:pages": "tsc -b && node scripts/run-vite-with-project-env.mjs build && node scripts/prepare-github-pages.mjs",
    "build:review": "tsc -b && node scripts/run-vite-with-project-env.mjs build --mode review && node scripts/prepare-github-pages.mjs",
    "build:hosting": "tsc -b && node scripts/run-vite-with-project-env.mjs build --mode review && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "backend:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-backend.ps1",
    "backend:typecheck": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/typecheck-edge-functions.ps1",
    "backend:test": "npx -y deno test supabase/functions/tests",
    "backend:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-backend.ps1",
    "auth:verify:production": "node scripts/verify-production-auth.mjs",
    "screenshots": "node scripts/capture-figma-pages.mjs",
    "screenshots:legacy": "node scripts/capture-screenshots.mjs",
    "screenshots:auth": "node scripts/capture-auth-v3.mjs",
    "screenshots:background": "node scripts/capture-background-states.mjs",
    "screenshots:motion": "node scripts/capture-motion-background.mjs",
    "interaction:test": "node scripts/verify-interactions.mjs",
    "icons:test": "node scripts/verify-navigation-icons.mjs",
    "supabase:verify-shared": "node scripts/verify-shared-supabase.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy",
    "motion:test": "node --experimental-strip-types --test tests/background-motion.test.ts tests/mascot-motion.test.ts",
    "chart-motion:test": "node --experimental-strip-types --test tests/chart-motion.test.ts tests/chart-curves.test.ts",
    "weekly-report:test": "node --experimental-strip-types --test tests/weekly-report.test.ts",
    "report-share:test": "node --experimental-strip-types --test tests/report-share-card.test.ts tests/device-date.test.ts",
    "navigation:test": "node --experimental-strip-types --test tests/shell-history.test.ts",
    "ai:speech:test": "node --experimental-strip-types --test tests/ai-speech.test.ts",
    "voice:endpoint:test": "node --experimental-strip-types --test tests/voice-endpoint.test.ts",
    "reward:test": "node --experimental-strip-types --test tests/growth-reward-presentation.test.ts tests/growth-progress-presentation.test.ts",
    "ai:prompt:test": "node --experimental-strip-types --test tests/ai-chat-prompt.test.ts tests/ai-context-router.test.ts tests/ai-review-access.test.ts",
    "structured:test": "node --experimental-strip-types --test tests/structured-entry.test.ts",
    "algorithm:test": "node --experimental-strip-types --test tests/rhythm-core.test.ts",
    "fdnb:test": "node --experimental-strip-types --test tests/fdnb-health-core.test.ts",
    "algorithm:benchmark": "node --experimental-strip-types scripts/benchmark-rhythm-v4.ts",
    "algorithm:benchmark:fixed": "node --experimental-strip-types scripts/benchmark-fixed-dataset.ts",
    "algorithm:compare:fixed": "node --experimental-strip-types scripts/compare-fixed-benchmarks.ts",
    "data:audit": "node --experimental-strip-types scripts/audit-synthetic-distribution.ts",
    "data:export": "node --experimental-strip-types scripts/export-synthetic-population.ts",
    "data:export:fixed": "node --experimental-strip-types scripts/export-synthetic-population.ts --out=../Data/synthetic-population",
    "data:audit:account": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-account-history-secure.ps1 -AuditOnly",
    "data:seed:account": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-account-history-secure.ps1",
    "data:backfill:mood:account": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-mood-history-secure.ps1",
    "data:backfill:account": "node scripts/backfill-account-auxiliary.mjs",
    "algorithm:tune": "node --experimental-strip-types scripts/benchmark-rhythm-v4.ts --tune",
    "cap:sync": "npm run build && npx cap sync && npm run ios:configure-motion",
    "cap:add:ios": "npx cap add ios && npm run ios:configure-motion",
    "cap:open:ios": "npx cap open ios",
    "ios:configure-motion": "node scripts/configure-ios-motion.mjs",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "ios:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-ios-project.ps1",
    "upstream:diff": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-web-upstream.ps1"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/local-notifications": "^7.0.7",
    "@supabase/supabase-js": "^2.52.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "supabase": "^2.109.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.1.5"
  }
}
