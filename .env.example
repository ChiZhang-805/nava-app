VITE_SUPABASE_URL=https://wxteapvwagvhhtrjrbim.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_APP_ENV=development
# Public preview only: lets a hosted review link open the full App without login.
VITE_ENABLE_REVIEW_DEMO=false
VITE_WEB_UPSTREAM_REPO=https://github.com/Tj-jiaoao/style-muse-next.git
# Public readiness switch only. Add a provider after its OAuth credentials and
# callback URLs are configured in Supabase, for example: wechat,apple,qq
VITE_SOCIAL_AUTH_PROVIDERS=
# Public GET endpoint used only to wake the SMS relay before Supabase invokes
# its five-second Send SMS Hook. It must not contain credentials or tokens.
VITE_SMS_RELAY_WARMUP_URL=https://nava-sms-relay-yxmupnxmau.cn-hangzhou.fcapp.run/

# Social OAuth provider credentials are server-only Supabase Edge Function
# secrets. Names are documented here; never place their values in a VITE_*
# variable or commit them to a local env file:
# WECHAT_APP_ID_NAVA, WECHAT_APP_SECRET_NAVA
# QQ_APP_ID_NAVA, QQ_API_KEY_NAVA
# NAVA_SOCIAL_OAUTH_STATE_SECRET
# NAVA_SOCIAL_AUTH_REDIRECT_URLS=nava://auth/callback,https://your-domain.example/

# Local deployment only. Do not expose these in the mobile bundle.
SUPABASE_PROJECT_REF=wxteapvwagvhhtrjrbim
# Needed only when applying hosted Auth email templates through the Management API.
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Configure these with `supabase secrets set`, not in the App frontend env file.
# DEEPSEEK_API_KEY=your-server-only-deepseek-key
# Optional server-only USDA FoodData Central API key. Production should use a
# dedicated data.gov key. DEMO_KEY is suitable only for low-volume validation.
# USDA_FDC_API_KEY=your-data-gov-key
# USDA_FDC_ALLOW_DEMO_KEY=false
# Food-photo recognition is a separate multimodal AI path. DeepSeek's text API
# does not accept image input. The default provider is Alibaba Cloud Model Studio
# (Qwen VL); set this secret in Supabase Edge Function Secrets.
# DASHSCOPE_API_KEY=your-model-studio-api-key
# Optional OpenAI-compatible vision-provider overrides:
# NAVA_DIET_VISION_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# NAVA_DIET_VISION_KEY=your-vision-api-key
# NAVA_DIET_VISION_MODEL=qwen3-vl-plus
# Optional custom extraction service (takes precedence over the vision provider):
# NAVA_DIET_EXTRACT_URL=
# NAVA_DIET_EXTRACT_KEY=
# NAVA_FACE_ANALYZE_URL=
# NAVA_FACE_ANALYZE_KEY=
# Required only by scripts/configure-sms-secrets.ps1 and never bundled into the App.
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
# ALIYUN_SMS_ENDPOINT=dysmsapi.ap-southeast-1.aliyuncs.com
# Standard Webhooks secret shared by Supabase Auth and the auth-send-sms Edge
# Function. Configure it only after creating the HTTP Send SMS Hook.
# SEND_SMS_HOOK_SECRET=v1,whsec_base64-value
# Optional: provide a stable 32+ character value; otherwise the script generates one.
# NAVA_OTP_HMAC_SECRET=

# Required only by scripts/configure-auth-smtp.ps1. Keep these out of frontend builds.
# NAVA_SMTP_HOST=
# NAVA_SMTP_PORT=587
# NAVA_SMTP_USER=
# NAVA_SMTP_PASSWORD=
# NAVA_SMTP_FROM_EMAIL=no-reply@auth.example.com
# NAVA_SMTP_SENDER_NAME=NAVA
