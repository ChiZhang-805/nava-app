# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Configure these with `supabase secrets set`, not in the App frontend env file.
# NAVA_DIET_EXTRACT_URL=
# NAVA_DIET_EXTRACT_KEY=
# NAVA_FACE_ANALYZE_URL=
# NAVA_FACE_ANALYZE_KEY=
# Required only by scripts/configure-sms-secrets.ps1 and never bundled into the App.
